GEMINI_API_KEY=
GEMMA_API_KEY=
OPENAI_API_KEY=

GOOGLE_OAUTH_CLIENT_SECRET_JSON=oauth_client_secret.json
GOOGLE_OAUTH_TOKEN_JSON=token.json

GDRIVE_OUTPUT_FOLDER_ID=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# Gemini is the primary video-analysis provider.
# Full waterfall (best -> worst); comma list = tried in order, falling
# through to the next on a hard failure. Comment this out entirely to use
# analyze.py's built-in defaults instead (recommended, so you get this
# waterfall updated automatically if you re-pull the script later).
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Goal pass tries this model FIRST, then falls back through GEMINI_MODELS
# above. Requires billing enabled (Pro-tier models are off the free tier
# as of ~April 2026) — without billing this just fails fast and falls
# through to GEMINI_MODELS automatically, no pipeline break either way.
GEMINI_GOAL_MODEL=gemini-3.1-pro-preview

# Optional Gemma/provider fallback.
GEMMA_MODEL=gemma-4-27b-it
# GEMMA_MODELS=gemma-4-27b-it

# Full-match proxy analysis. This is a single API analysis call, not chunked.
ANALYZE_USE_PROXY=true
ANALYZE_PROXY_WIDTH=854
ANALYZE_PROXY_FPS=4
ANALYZE_PROXY_CRF=28

# Reject outputs that miss the middle of the match or miss goals.
COVERAGE_SEGMENT_SECONDS=600
MAX_EVENT_GAP_SECONDS=900

# Expensive OpenCV frame refinement only runs for these event types.
REFINE_HIGH_PRECISION_TYPES=goal,penalty,save,near_miss,shot_on_target

# Goal slow-motion output duration is clamped to 7-10 seconds.
GOAL_SLOWMO_OUTPUT_SECONDS=9

# Parallel FFmpeg workers for clip extraction.
HIGHLIGHT_MAX_WORKERS=2


