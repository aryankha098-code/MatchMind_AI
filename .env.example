GEMINI_API_KEY=
GEMMA_API_KEY=
OPENAI_API_KEY=

GOOGLE_OAUTH_CLIENT_SECRET_JSON=oauth_client_secret.json
GOOGLE_OAUTH_TOKEN_JSON=token.json

GDRIVE_OUTPUT_FOLDER_ID=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# Gemini is the primary video-analysis provider.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
# GEMINI_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-2.0-flash

# Optional Gemma/provider fallback.
GEMMA_MODEL=gemma-4-27b-it
# GEMMA_MODELS=gemma-4-27b-it

# Full-match proxy analysis. This is a single API analysis call, not chunked.
ANALYZE_USE_PROXY=true
ANALYZE_PROXY_WIDTH=854
ANALYZE_PROXY_FPS=4
ANALYZE_PROXY_CRF=28

# Reject outputs that miss the middle of the match or miss goals.
COVERAGE_SEGMENT_SECONDS=600
MAX_EVENT_GAP_SECONDS=900

# Expensive OpenCV frame refinement only runs for these event types.
REFINE_HIGH_PRECISION_TYPES=goal,penalty,save,near_miss,shot_on_target

# Goal slow-motion output duration is clamped to 7-10 seconds.
GOAL_SLOWMO_OUTPUT_SECONDS=9

# Parallel FFmpeg workers for clip extraction.
HIGHLIGHT_MAX_WORKERS=2


